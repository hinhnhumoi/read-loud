<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.RL.Display"
                android:textSize="26sp"
                tools:text="ReadLoud" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                style="@style/Widget.RL.IconButton.Filled"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/action_add"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_plus"
                app:iconSize="24dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/continueLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/home_continue"
            android:textAppearance="@style/TextAppearance.RL.Section" />

        <!-- Continue card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/continueCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.tung.readloud.ui.CoverView
                        android:id="@+id/cover"
                        android:layout_width="84dp"
                        android:layout_height="116dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/novelName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:textAppearance="@style/TextAppearance.RL.NovelTitle"
                            tools:text="Toàn Chức Cao Thủ" />

                        <TextView
                            android:id="@+id/chapterLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.RL.Body"
                            android:textColor="@color/rl_muted"
                            tools:text="Chương 192 · đoạn 14/58" />

                        <TextView
                            android:id="@+id/bufferLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.RL.Body"
                            android:textColor="@color/rl_offline"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_check"
                            app:drawableTint="@color/rl_offline"
                            tools:text="Sẵn sàng 2 chương sau"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/noteLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textAppearance="@style/TextAppearance.RL.Meta"
                            android:textColor="@color/rl_warn"
                            android:visibility="gone"
                            tools:text="Máy chủ giọng đọc đang chậm, đợi thêm chút…" />
                    </LinearLayout>
                </LinearLayout>

                <include
                    android:id="@+id/homeBanner"
                    layout="@layout/view_status_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/chapterProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:max="1000" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chapterLeft"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.RL.Meta"
                        tools:text="Chương này còn ~14 phút" />

                    <TextView
                        android:id="@+id/storyPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAppearance="@style/TextAppearance.RL.Meta"
                        tools:text="Cả truyện 11%" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContinue"
                    style="@style/Widget.RL.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/action_continue"
                    app:icon="@drawable/ic_play" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- First run -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/emptyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_empty_title"
                    android:textAppearance="@style/TextAppearance.RL.NovelTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_empty_text"
                    android:textAppearance="@style/TextAppearance.RL.Body"
                    android:textColor="@color/rl_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyAdd"
                    style="@style/Widget.RL.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/action_add"
                    app:icon="@drawable/ic_plus" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent -->
        <LinearLayout
            android:id="@+id/recentHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_recent"
                android:textAppearance="@style/TextAppearance.RL.Section" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeeAll"
                style="@style/Widget.RL.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:paddingHorizontal="8dp"
                android:text="@string/library_see_all" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- Shortcuts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/shortcutLink"
                style="@style/RL.Shortcut"
                android:layout_marginEnd="12dp">

                <ImageView
                    style="@style/RL.Shortcut.Icon"
                    android:src="@drawable/ic_link" />

                <TextView
                    style="@style/RL.Shortcut.Title"
                    android:text="@string/shortcut_paste_link" />

                <TextView
                    style="@style/RL.Shortcut.Sub"
                    android:text="@string/shortcut_paste_link_sub" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcutFile"
                style="@style/RL.Shortcut">

                <ImageView
                    style="@style/RL.Shortcut.Icon"
                    android:src="@drawable/ic_file" />

                <TextView
                    style="@style/RL.Shortcut.Title"
                    android:text="@string/shortcut_open_file" />

                <TextView
                    style="@style/RL.Shortcut.Sub"
                    android:text="@string/shortcut_open_file_sub" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
