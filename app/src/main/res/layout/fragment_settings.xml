<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/mini_player_inset">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.RL.Display" />

        <!-- Voice: the main voice, and the phone voice that stands in when it fails -->
        <TextView
            style="@style/RL.SectionLabel"
            android:text="@string/section_voice" />

        <TextView
            android:id="@+id/voiceNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.RL.Meta"
            android:visibility="gone"
            tools:text="● Đang phát bằng giọng chính"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/primaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_voice_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/primaryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_primary_label"
                android:textAppearance="@style/TextAppearance.RL.Section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/primaryName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.RL.Title"
                        tools:text="Hoài My" />

                    <TextView
                        android:id="@+id/primaryDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.RL.Meta"
                        tools:text="Edge online · Nữ · miền Bắc · neural" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/primaryPlay"
                        style="@style/Widget.Material3.Button.IconButton.Outlined"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/voice_preview"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="22dp"
                        app:icon="@drawable/ic_play"
                        app:iconSize="18dp"
                        app:iconTint="@color/rl_text"
                        app:strokeColor="@color/rl_track" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/primaryLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/rl_accent"
                        app:indicatorSize="40dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="3dp" />
                </FrameLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePrimary"
                style="@style/Widget.RL.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="@string/voice_change" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chainRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/rl_faint" />

            <TextView
                android:id="@+id/chainNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.RL.Small"
                tools:text="@string/voice_chain_edge" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/backupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_voice_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/backupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_backup_label"
                android:textAppearance="@style/TextAppearance.RL.Section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/backupName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.RL.Title"
                        tools:text="Giọng máy · Google TTS" />

                    <TextView
                        android:id="@+id/backupDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.RL.Meta"
                        tools:text="Giọng tiếng Việt mặc định · offline" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backupPlay"
                    style="@style/Widget.Material3.Button.IconButton.Outlined"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/voice_preview"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_play"
                    app:iconSize="18dp"
                    app:iconTint="@color/rl_text"
                    app:strokeColor="@color/rl_track" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeBackup"
                style="@style/Widget.RL.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="@string/voice_change" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/systemOnlyRow"
            style="@style/RL.SettingRow"
            android:layout_marginTop="8dp">

            <LinearLayout style="@style/RL.SettingRow.Texts">

                <TextView
                    style="@style/RL.SettingRow.Title"
                    android:text="@string/voice_system_only" />

                <TextView
                    style="@style/RL.SettingRow.Sub"
                    android:text="@string/voice_system_only_hint" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/systemOnlySwitch"
                style="@style/Widget.RL.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- How it reads -->
        <TextView
            style="@style/RL.SectionLabel"
            android:text="@string/settings_style" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_rate"
                android:textAppearance="@style/TextAppearance.RL.BodyLarge" />

            <TextView
                android:id="@+id/rateValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RL.Title"
                android:textColor="@color/rl_accent"
                tools:text="1.3×" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/rateSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-10dp"
            android:contentDescription="@string/label_rate"
            android:stepSize="0.1"
            android:value="1.0"
            android:valueFrom="0.5"
            android:valueTo="2.0" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/rateChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/rate10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0×" />

            <com.google.android.material.chip.Chip
                android:id="@+id/rate13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.3×" />

            <com.google.android.material.chip.Chip
                android:id="@+id/rate15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.5×" />

            <com.google.android.material.chip.Chip
                android:id="@+id/rate20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.0×" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_pitch"
                android:textAppearance="@style/TextAppearance.RL.BodyLarge" />

            <TextView
                android:id="@+id/pitchValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RL.Title"
                tools:text="1.0" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/pitchSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-10dp"
            android:contentDescription="@string/label_pitch"
            android:stepSize="0.1"
            android:value="1.0"
            android:valueFrom="0.5"
            android:valueTo="1.5" />

        <!-- Buffer ahead -->
        <TextView
            android:id="@+id/bufferLabel"
            style="@style/RL.SectionLabel"
            android:text="@string/buffer_title" />

        <com.tung.readloud.ui.SegmentedControl
            android:id="@+id/bufferSegment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/bufferHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_buffer_hint"
            android:textAppearance="@style/TextAppearance.RL.Meta" />

        <!-- Saving for offline -->
        <TextView
            style="@style/RL.SectionLabel"
            android:text="@string/night_title" />

        <com.tung.readloud.ui.SegmentedControl
            android:id="@+id/nightSegment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/night_hint"
            android:textAppearance="@style/TextAppearance.RL.Meta" />

        <TextView
            style="@style/RL.SectionLabel"
            android:text="@string/keep_title" />

        <com.tung.readloud.ui.SegmentedControl
            android:id="@+id/keepSegment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/keep_hint"
            android:textAppearance="@style/TextAppearance.RL.Meta" />

        <LinearLayout
            android:id="@+id/rowSaved"
            style="@style/RL.SettingRow"
            android:layout_marginTop="8dp">

            <LinearLayout style="@style/RL.SettingRow.Texts">

                <TextView
                    style="@style/RL.SettingRow.Title"
                    android:text="@string/saved_title" />

                <TextView
                    android:id="@+id/savedSummary"
                    style="@style/RL.SettingRow.Sub"
                    tools:text="12 chương · 45 MB" />
            </LinearLayout>
        </LinearLayout>

        <!-- More -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/rl_line" />

        <LinearLayout
            android:id="@+id/rowRules"
            style="@style/RL.SettingRow">

            <LinearLayout style="@style/RL.SettingRow.Texts">

                <TextView
                    style="@style/RL.SettingRow.Title"
                    android:text="@string/rules_title" />

                <TextView
                    android:id="@+id/rulesSummary"
                    style="@style/RL.SettingRow.Sub"
                    tools:text="12 quy tắc · HP → máu, Lv → cấp" />
            </LinearLayout>

            <ImageView
                style="@style/RL.SettingRow.Chevron"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <View style="@style/RL.Divider" />

        <LinearLayout
            android:id="@+id/rowHealth"
            style="@style/RL.SettingRow">

            <LinearLayout style="@style/RL.SettingRow.Texts">

                <TextView
                    style="@style/RL.SettingRow.Title"
                    android:text="@string/settings_health" />

                <TextView
                    android:id="@+id/healthSummary"
                    style="@style/RL.SettingRow.Sub"
                    tools:text="Cần cho phép chạy nền" />
            </LinearLayout>

            <ImageView
                style="@style/RL.SettingRow.Chevron"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <View style="@style/RL.Divider" />

        <LinearLayout
            android:id="@+id/rowLog"
            style="@style/RL.SettingRow">

            <LinearLayout style="@style/RL.SettingRow.Texts">

                <TextView
                    style="@style/RL.SettingRow.Title"
                    android:text="@string/event_log_title" />

                <TextView
                    style="@style/RL.SettingRow.Sub"
                    android:text="@string/settings_log_sub" />
            </LinearLayout>

            <ImageView
                style="@style/RL.SettingRow.Chevron"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.RL.Small"
            android:textColor="@color/rl_faint"
            tools:text="Phiên bản 0.13" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
