<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/library_title"
            android:textAppearance="@style/TextAppearance.RL.Display" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textAppearance="@style/TextAppearance.RL.Meta"
            tools:text="5 truyện · 2 sách" />
    </LinearLayout>

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:drawableTint="@color/rl_faint"
        android:hint="@string/library_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:textAppearance="@style/TextAppearance.RL.Body"
        android:textColorHint="@color/rl_faint" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_margin"
            app:checkedChip="@id/filterAll"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterWeb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_filter_web" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterBook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_filter_book" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterOffline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_filter_offline" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="6dp"
            android:paddingBottom="@dimen/mini_player_inset" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:textAppearance="@style/TextAppearance.RL.Body"
            android:textColor="@color/rl_muted"
            android:visibility="gone"
            tools:text="@string/library_empty" />
    </FrameLayout>
</LinearLayout>
