<?xml version="1.0" encoding="utf-8"?>
<!-- A state that needs the listener: a bot check, a load error, the end of the story. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bannerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_banner"
    android:orientation="vertical"
    android:padding="18dp"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bannerIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_shield"
            android:visibility="gone"
            app:tint="@color/rl_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bannerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RL.Title"
                tools:text="Trang truyện yêu cầu xác minh bạn không phải robot" />

            <TextView
                android:id="@+id/bannerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.RL.Meta"
                tools:text="Thường chỉ cần bấm một ô. Qua là app tự đọc tiếp." />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bannerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bannerPrimary"
            style="@style/Widget.RL.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="46dp"
            tools:text="Mở trang để xác minh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bannerSecondary"
            style="@style/Widget.RL.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minHeight="46dp"
            android:visibility="gone"
            tools:text="Dán link khác" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bannerTertiary"
            style="@style/Widget.RL.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:visibility="gone"
            tools:text="Nhật ký" />
    </LinearLayout>
</LinearLayout>
